{
  "name": "@hadden-industries/owlapi",
  "version": "0.1.0-rc.2",
  "description": "OWL 2 ontology parsing and structural APIs for Node.js and browsers, designed for practical compatibility with Java OWLAPI concepts.",
  "keywords": [
    "owl",
    "owl2",
    "owlapi",
    "ontology",
    "ontology-parser",
    "semantic-web",
    "linked-data",
    "rdf",
    "rdfjs",
    "rdfxml",
    "turtle",
    "jsonld"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./apibinding": "./apibinding/index.js",
    "./model": "./model/index.js",
    "./io": "./io/index.js",
    "./io/node": "./io/node/index.js",
    "./formats": "./formats/index.js",
    "./profiles": "./profiles/index.js",
    "./util": "./util/index.js",
    "./model/parameters": "./model/parameters/index.js",
    "./search": "./search/index.js",
    "./manchestersyntax/renderer": "./manchestersyntax/renderer/index.js",
    "./modularity/locality": "./modularity/locality/index.js"
  },
  "files": [
    "index.js",
    "apibinding/",
    "model/",
    "io/",
    "formats/",
    "profiles/",
    "search/",
    "manchestersyntax/",
    "modularity/locality/",
    "util/index.js",
    "util/owlOntologyImportsClosureSetProvider.js",
    "util/owlOntologyMerger.js",
    "util/owlObjectDuplicator.js",
    "util/owlEntityRenamer.js",
    "util/owlEntityRemover.js",
    "util/simpleShortFormProvider.js",
    "util/annotationValueShortFormProvider.js",
    "internal/",
    "README.md",
    "API.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES/Apache-2.0.txt",
    "NOTICE",
    "docs/compatibility/capabilities.json",
    "docs/compatibility/canonical-vowl-prerequisites.md",
    "docs/compatibility/default-behavior-inventory.md",
    "docs/compatibility/rdf-parser-metadata.md",
    "docs/compatibility/rdfxml-writer-configuration.md",
    "docs/compatibility/java-api-surface.json",
    "docs/compatibility/java-api-surface.md",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "!**/__tests__/**",
    "!**/test/**",
    "!**/fixtures/**",
    "docs/compatibility/behavior-profiles.md",
    "docs/compatibility/java-api-parity-decisions.json",
    "docs/compatibility/java-api-parity-decisions.schema.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.2.1",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "fsevents@2.3.3": false,
    "libxmljs2@0.37.0": false,
    "unrs-resolver@1.12.2": false,
    "lzma-native@8.0.6": false
  },
  "browserslist": "baseline widely available",
  "scripts": {
    "acquire:npm-evidence": "node util/acquire-npm-package-evidence.mjs",
    "build:release-candidate": "node scripts/build-release-candidate.mjs",
    "check:json": "node scripts/run-json-quality.mjs check",
    "check:markdown": "npm --prefix tooling/markdown run check --",
    "check:node": "node scripts/project-node-support.mjs --check",
    "check:published-coordinate": "node scripts/maintenance-published-health.mjs",
    "check:python-tools": "node scripts/repository-python-tools.mjs check",
    "check:release-preflight": "node scripts/release-preflight.mjs",
    "create:github-release-draft": "node scripts/create-github-release-draft.mjs",
    "finalize:github-release": "node scripts/finalize-github-release.mjs",
    "format": "npm run check:python-tools && npm run format:source && npm run format:markdown && npm run format:py && npm run format:json",
    "format:check": "npm run check:node && npm run check:python-tools && npm run format:source:check && npm run check:markdown && npm run format:py:check && npm run format:json:check",
    "format:json": "node scripts/run-json-quality.mjs format",
    "format:json:check": "node scripts/run-json-quality.mjs check",
    "format:markdown": "npm --prefix tooling/markdown run format --",
    "format:py": "node scripts/repository-python-tools.mjs ruff format",
    "format:py:check": "node scripts/repository-python-tools.mjs ruff format --check",
    "format:source": "npm run run:prettier -- --write",
    "format:source-python:check": "npm run check:python-tools && npm run format:source:check && npm run format:py:check",
    "format:source:check": "npm run run:prettier -- --check",
    "generate:release-evidence": "node scripts/generate-release-evidence.mjs",
    "generate:release-gates": "node scripts/generate-release-gate-registry.mjs --write",
    "generate:release-sbom": "node scripts/generate-release-sbom.mjs",
    "generate:workflow-metadata": "node scripts/workflow-metadata.mjs",
    "graph:dependencies": "node scripts/dependency-graph.mjs",
    "inspect:json": "node scripts/run-json-quality.mjs check --json",
    "inspect:markdown": "npm --prefix tooling/markdown run inspect --",
    "inspect:markdown:profile": "npm --prefix tooling/markdown run inspect:profile --",
    "install:markdown": "npm ci --prefix tooling/markdown --ignore-scripts --no-audit --no-fund",
    "install:playwright-browsers": "playwright install",
    "lint": "npm run check:python-tools && npm run lint:js && npm run check:markdown && npm run lint:py && npm run check:json && npm run lint:json-identity",
    "lint:files": "eslint",
    "lint:js": "npm run check:node && eslint \"**/*.{js,mjs,cjs}\"",
    "lint:json-identity": "eslint --config eslint.json-identity.config.mjs \"**/*.{js,mjs,cjs}\"",
    "lint:package": "publint --strict",
    "lint:py": "node scripts/repository-python-tools.mjs ruff check",
    "lint:source-python": "npm run check:python-tools && npm run lint:js && npm run lint:py",
    "normalize:json": "node scripts/run-json-quality.mjs normalize",
    "prepare:browser-consumers": "node scripts/prepare-browser-consumers.mjs",
    "prepare:downloaded-candidate": "node scripts/prepare-downloaded-candidate.mjs",
    "prepare:github-cli": "node scripts/prepare-github-cli.mjs",
    "qualify:git-package-equivalence": "node scripts/qualify-git-package-equivalence.mjs",
    "qualify:installed-candidate": "node scripts/qualify-installed-candidate.mjs",
    "qualify:markdown": "npm --prefix tooling/markdown run qualify --",
    "qualify:public-registry": "node scripts/qualify-public-registry.mjs",
    "qualify:release": "node scripts/qualify-release.mjs",
    "record:extended-test-status": "node scripts/record-extended-test-status.mjs",
    "record:runner": "node scripts/record-runner.mjs",
    "rehearse:release-state": "node scripts/rehearse-release-state.mjs",
    "report:dependency-review-applicability": "node scripts/report-dependency-review-applicability.mjs",
    "require:successful-jobs": "node scripts/require-job-success.mjs",
    "run:prettier": "prettier --ignore-unknown . --ignore-path .gitignore --ignore-path .prettierignore",
    "serve:browser-consumers": "node scripts/serve-browser-consumers.mjs",
    "sync:node": "node scripts/project-node-support.mjs --write",
    "sync:python-tools": "node scripts/repository-python-tools.mjs sync",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "test:boundary": "node --test test/package-boundary.test.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:json": "node --test scripts/json-quality.probes.mjs scripts/json-quality-preservation.probes.mjs",
    "test:markdown": "node --test scripts/markdown-quality.probes.mjs scripts/dependency-security-markdown.probes.mjs",
    "test:owl-contract": "node scripts/qualify-owl-contract.mjs",
    "test:quality": "npm run test:quality:source && npm run test:markdown && npm run test:json",
    "test:quality:source": "npm test -- --runInBand --runTestsByPath scripts/repository-python-tools.test.js scripts/source-policy.test.js",
    "test:universal-ontology": "node util/owlapi-reference/qualify-universal-ontology.mjs",
    "validate:release-evidence": "node scripts/validate-release-evidence.mjs",
    "verify:architecture": "node scripts/dependency-graph.mjs --check-architecture",
    "verify:immutable-release": "node scripts/verify-immutable-release.mjs",
    "verify:npm-evidence": "node util/verify-npm-package-evidence.mjs",
    "verify:release-gates": "node scripts/verify-release-gates.mjs --json",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "verify:workflow-governance": "node scripts/workflow-governance.mjs",
    "verify:workflow-syntax": "actionlint -shellcheck= -pyflakes="
  },
  "dependencies": {
    "@hyperjump/uri": "1.3.9",
    "@rdfjs/data-model": "2.1.2",
    "@rdfjs/dataset": "2.0.3",
    "@xmldom/xmldom": "0.9.12",
    "bcp-47": "2.1.2",
    "iconv-lite": "0.7.3",
    "jsonld": "9.0.0",
    "lzma-native": "8.0.6",
    "n3": "2.13.12",
    "rdfxml-streaming-parser": "3.3.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-library": ">=10.3.0",
    "@cyclonedx/cyclonedx-npm": ">=6.0.1",
    "@eslint/js": ">=10.0.1",
    "@hadden-industries/json-quality": "1.0.0-rc.2",
    "@jspm/generator": ">=2.18.0",
    "@playwright/test": ">=1.64.1",
    "ajv": ">=8.20.0",
    "ajv-formats": ">=3.0.1",
    "cross-env": ">=10.1.0",
    "dependency-cruiser": ">=18.7.0",
    "eslint": ">=10.13.0",
    "eslint-config-prettier": ">=10.1.8",
    "eslint-plugin-compat": ">=7.0.2",
    "globals": ">=17.13.0",
    "jest": ">=30.5.2",
    "jsonpath-rfc9535": ">=1.3.0",
    "pacote": ">=22.0.1",
    "prettier": ">=3.9.10",
    "publint": ">=0.3.25",
    "semver": ">=7.8.5",
    "spdx-expression-parse": ">=5.0.0",
    "tar": ">=7.5.22",
    "vite": ">=8.3.5",
    "yaml": ">=2.9.1"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config@1.1.0": {
      "js-yaml": ">=5.5.0 <6"
    },
    "source-map-js": ">=1.2.2 <2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hadden-Industries/owlapi.git"
  },
  "bugs": {
    "url": "https://github.com/Hadden-Industries/owlapi/issues"
  },
  "homepage": "https://github.com/Hadden-Industries/owlapi#readme",
  "author": {
    "name": "Maksym Shostak",
    "url": "https://github.com/MaksymShostak"
  },
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/.release/",
      "<rootDir>/\\.venv/",
      "<rootDir>/\\.development-tools/"
    ],
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/test/consumers/owl-contract/",
      "<rootDir>/\\.venv/",
      "<rootDir>/\\.development-tools/",
      "/test/package-boundary.test.mjs"
    ]
  }
}
