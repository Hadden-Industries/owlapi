{
  "name": "@hadden-industries/owlapi",
  "version": "0.1.0-rc.1",
  "description": "OWL 2 ontology parsing and structural APIs for Node.js and browsers, designed for practical compatibility with Java OWLAPI concepts.",
  "keywords": [
    "owl",
    "owl2",
    "owlapi",
    "ontology",
    "ontology-parser",
    "semantic-web",
    "linked-data",
    "rdf",
    "rdfjs",
    "rdfxml",
    "turtle",
    "jsonld"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./apibinding": "./apibinding/index.js",
    "./model": "./model/index.js",
    "./io": "./io/index.js",
    "./formats": "./formats/index.js",
    "./profiles": "./profiles/index.js",
    "./util": "./util/index.js"
  },
  "files": [
    "index.js",
    "apibinding/",
    "model/",
    "io/",
    "formats/",
    "profiles/",
    "util/index.js",
    "util/owlOntologyImportsClosureSetProvider.js",
    "util/owlOntologyMerger.js",
    "internal/",
    "README.md",
    "API.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES/Apache-2.0.txt",
    "NOTICE",
    "docs/compatibility/capabilities.json",
    "docs/compatibility/canonical-vowl-prerequisites.md",
    "docs/compatibility/rdf-parser-metadata.md",
    "docs/compatibility/java-api-surface.json",
    "docs/compatibility/java-api-surface.md",
    "!**/*.test.js",
    "!**/*.test.mjs",
    "!**/__tests__/**",
    "!**/test/**",
    "!**/fixtures/**"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.23.3 <23 || >=24.21.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.1.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "fsevents@2.3.3": false,
    "libxmljs2@0.37.0": false,
    "unrs-resolver@1.12.2": false
  },
  "browserslist": "baseline widely available",
  "scripts": {
    "browser:prepare": "node scripts/prepare-browser-consumers.mjs",
    "browser:serve": "node scripts/serve-browser-consumers.mjs",
    "candidate:prepare": "node scripts/prepare-downloaded-candidate.mjs",
    "candidate:portable": "node scripts/qualify-installed-candidate.mjs",
    "qualify:git-package-equivalence": "node scripts/qualify-git-package-equivalence.mjs",
    "evidence:acquire": "node util/acquire-npm-package-evidence.mjs",
    "evidence:verify": "node util/verify-npm-package-evidence.mjs",
    "generate:release-gates": "node scripts/generate-release-gate-registry.mjs --write",
    "maintenance:published-health": "node scripts/maintenance-published-health.mjs",
    "playwright:install": "playwright install",
    "workflow:runner-record": "node scripts/record-runner.mjs",
    "workflow:metadata": "node scripts/workflow-metadata.mjs",
    "workflow:aggregate": "node scripts/require-job-success.mjs",
    "workflow:dependency-review-applicability": "node scripts/report-dependency-review-applicability.mjs",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest",
    "test:boundary": "node --test test/package-boundary.test.mjs",
    "test:owl-contract": "node scripts/qualify-owl-contract.mjs",
    "test:universal-ontology": "node util/owlapi-reference/qualify-universal-ontology.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "verify:release-gates": "node scripts/verify-release-gates.mjs --json",
    "verify:workflow-governance": "node scripts/workflow-governance.mjs",
    "verify:workflow-syntax": "actionlint -shellcheck= -pyflakes=",
    "qualify:release": "node scripts/qualify-release.mjs",
    "release:lint-package": "publint --strict",
    "release:pack": "node scripts/build-release-candidate.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:verify-tag": "node scripts/verify-release-tag.mjs",
    "release:rehearse-state": "node scripts/rehearse-release-state.mjs",
    "release:draft-github": "node scripts/create-github-release-draft.mjs",
    "release:finalize-github": "node scripts/finalize-github-release.mjs",
    "release:qualify-registry": "node scripts/qualify-public-registry.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "release:evidence:validate": "node scripts/validate-release-evidence.mjs",
    "release:prepare-github-cli": "node scripts/prepare-github-cli.mjs",
    "release:verify-immutable": "node scripts/verify-immutable-release.mjs",
    "extended:record-status": "node scripts/record-extended-test-status.mjs",
    "release:sbom": "cyclonedx-npm --spec-version 1.6 --output-format JSON --output-reproducible --validate --mc-type library --omit dev",
    "tools:sync": "node scripts/repository-python-tools.mjs sync",
    "tools:check": "node scripts/repository-python-tools.mjs check",
    "lint": "npm run tools:check && npm run lint:js && npm run lint:md && npm run lint:py",
    "lint:js": "eslint \"**/*.{js,mjs,cjs}\"",
    "lint:md": "npm --prefix tooling/markdown run check --",
    "lint:py": "node scripts/repository-python-tools.mjs ruff check",
    "lint:files": "eslint",
    "format": "npm run tools:check && npm run format:source && npm run format:md && npm run format:py",
    "format:check": "npm run tools:check && npm run format:source:check && npm run format:md:check && npm run format:py:check",
    "format:source": "prettier --write --ignore-unknown . \"!**/*.md\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:source:check": "prettier --check --ignore-unknown . \"!**/*.md\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:md": "npm --prefix tooling/markdown run format --",
    "format:md:check": "npm --prefix tooling/markdown run check --",
    "format:py": "node scripts/repository-python-tools.mjs ruff format",
    "format:py:check": "node scripts/repository-python-tools.mjs ruff format --check",
    "test:quality": "npm run test:quality:source && npm run test:markdown",
    "lint:source-python": "npm run tools:check && npm run lint:js && npm run lint:py",
    "format:source-python:check": "npm run tools:check && npm run format:source:check && npm run format:py:check",
    "test:quality:source": "npm test -- --runInBand --runTestsByPath scripts/repository-python-tools.test.js scripts/source-policy.test.js",
    "test:markdown": "node --test scripts/markdown-quality.test.mjs scripts/dependency-security-markdown.probes.mjs",
    "inspect:md": "npm --prefix tooling/markdown run inspect --",
    "qualify:md": "npm --prefix tooling/markdown run qualify --",
    "install:markdown": "npm ci --prefix tooling/markdown --ignore-scripts --no-audit --no-fund"
  },
  "dependencies": {
    "@hyperjump/uri": "1.3.6",
    "@rdfjs/data-model": "2.1.2",
    "@rdfjs/dataset": "2.0.3",
    "@xmldom/xmldom": "0.9.12",
    "bcp-47": "2.1.1",
    "jsonld": "9.0.0",
    "n3": "2.7.12",
    "rdfxml-streaming-parser": "3.3.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@jspm/generator": "2.16.3",
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cross-env": "10.1.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-compat": "7.0.2",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jsonpath-rfc9535": "1.3.0",
    "pacote": "22.0.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "semver": "7.8.5",
    "spdx-expression-parse": "5.0.0",
    "tar": "7.5.22",
    "vite": "8.3.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config@1.1.0": {
      "js-yaml": ">=4.3.2 <5"
    },
    "source-map-js": ">=1.2.2 <2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hadden-Industries/owlapi.git"
  },
  "bugs": {
    "url": "https://github.com/Hadden-Industries/owlapi/issues"
  },
  "homepage": "https://github.com/Hadden-Industries/owlapi#readme",
  "author": {
    "name": "Maksym Shostak",
    "url": "https://github.com/MaksymShostak"
  },
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "jest": {
    "modulePathIgnorePatterns": [
      "<rootDir>/.release/",
      "<rootDir>/\\.venv/",
      "<rootDir>/\\.development-tools/"
    ],
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/test/consumers/owl-contract/",
      "<rootDir>/\\.venv/",
      "<rootDir>/\\.development-tools/",
      "/test/package-boundary.test.mjs"
    ]
  }
}
