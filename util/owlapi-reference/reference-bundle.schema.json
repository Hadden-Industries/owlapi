{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "redistribution",
    "source",
    "inputRecordSha256",
    "inventory",
    "classpath"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "purpose": { "const": "LOCAL_RELOCATION_EXPERIMENT" },
    "redistribution": { "const": "NOT_CLEARED" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "inputRecordSha256": { "$ref": "#/definitions/digest" },
    "inventory": {
      "type": "array",
      "minItems": 2,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^(runtime/[0-9]{3}\\.jar|notices/[a-z0-9][a-z0-9._-]{0,100}\\.txt)$"
          },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
          "sha256": { "$ref": "#/definitions/digest" }
        }
      }
    },
    "classpath": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^runtime/[0-9]{3}\\.jar$" }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
