Prefix(:=<urn:owlapi-js:import-closure#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Ontology(<urn:owlapi-js:import-closure:root> <urn:owlapi-js:import-closure:root:v1>
  Annotation(rdfs:label "root annotation only"@en)
  Declaration(Class(:Root))
  Declaration(Class(:Shared))
  Declaration(Class(:MemberA))
  Declaration(Class(:MemberB))
  Declaration(ObjectProperty(:links))
  Declaration(NamedIndividual(:named))
  ClassAssertion(:Root _:collapsed-root-individual)
  ObjectPropertyAssertion(:links _:collapsed-root-individual :named)
  ClassAssertion(:MemberA _:collapsed-member-a-individual)
  ClassAssertion(:MemberB _:collapsed-member-b-individual)
)
