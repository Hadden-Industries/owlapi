  "rationales": [
    {
      "id": "valid-empty",
      "rules": ["owl-typing"],
      "reason": "Declarations alone impose no conflicting roles or global restrictions."
    },
    {
      "id": "valid-subclass",
      "rules": ["owl-typing"],
      "reason": "A subclass axiom between declared classes satisfies the structural restrictions."
    },
    {
      "id": "invalid-nonsimple",
      "rules": ["owl-simple", "owl-global"],
      "reason": "Transitivity makes p composite; functionality requires simplicity."
    },
    {
      "id": "invalid-punning",
      "rules": ["owl-typing"],
      "reason": "p is declared in both object- and data-property categories."
    },
    {
      "id": "invalid-class-datatype",
      "rules": ["owl-typing"],
      "reason": "A is declared as both class and datatype."
    },
    {
      "id": "invalid-datatype-cycle",
      "rules": ["owl-global"],
      "reason": "Definitions x to y and y to x violate strict datatype ordering."
    },
    {
      "id": "invalid-datatype-count",
      "rules": ["owl-global"],
      "reason": "x has two distinct definitions."
    },
    {
      "id": "invalid-annotated-datatype-count",
      "rules": ["owl-structural", "owl-global", "local-contract"],
      "reason": "Different axiom annotations preserve two distinct definitions, despite equal ranges."
    },
    {
      "id": "valid-integer",
      "rules": ["owl-literals", "xsd-integer"],
      "reason": "The lexical form 3 denotes an integer."
    },
    {
      "id": "invalid-integer",
      "rules": ["owl-literals", "xsd-integer"],
      "reason": "The lexical form bad does not denote an integer."
    },
    {
      "id": "byte-overflow",
      "rules": ["owl-literals", "xsd-byte", "local-contract"],
      "reason": "300 exceeds the xsd:byte maximum 127; a digit-only lexical pattern does not establish a value in this datatype."
    },
    {
      "id": "bad-annotation-literal",
      "rules": ["owl-literals", "local-contract"],
      "reason": "The annotation contains an ill-typed integer literal."
    },
    {
      "id": "singleton-original-pair",
      "rules": ["owl-structural", "owl-intersection", "local-contract"],
      "reason": "Set normalization leaves one operand, invalid for the formal intersection. The package-owned original two-operand syntax qualifies the source assessment only."
    },
    {
      "id": "named-top-simple",
      "rules": ["owl-simple", "owl-global"],
      "reason": "Named top is composite, so cannot be functional."
    },
    {
      "id": "inverse-top-simple",
      "rules": ["owl-simple", "local-contract"],
      "reason": "The published initial composite rule names top, not its inverse expression. This case supplies no hierarchy, chain or transitivity evidence making that inverse nonsimple; the documented literal-rule interpretation applies."
    },
    {
      "id": "reverse-pattern-range",
      "rules": ["xsd-regex", "local-contract"],
      "reason": "The selected XSD 1.1 range grammar admits z-a, whose range contains no code points. Empty denotation is not malformed syntax or a logical-consistency verdict."
    },
    {
      "id": "undeclared-typed-use",
      "rules": ["owl-typing", "local-contract"],
      "reason": "The formal structure lacks class declarations. Package-owned unambiguous class-position evidence qualifies the source assessment without synthesizing declarations."
    },
    {
      "id": "import-nonsimple-forward",
      "rules": ["owl-imports", "owl-simple", "owl-global"],
      "reason": "Imported transitivity combines with root functionality across the closure."
    },
    {
      "id": "import-nonsimple-reverse",
      "rules": ["owl-imports", "owl-simple", "owl-global"],
      "reason": "Root transitivity combines with imported functionality across the closure."
    },
    {
      "id": "import-bad-annotation",
      "rules": ["owl-imports", "owl-literals", "local-contract"],
      "reason": "The imported ontology's ill-typed annotation remains in scope."
    }
  ],
