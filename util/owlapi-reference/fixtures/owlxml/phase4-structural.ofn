Prefix(:=<urn:owlapi-js:phase4:>)
Ontology(<urn:owlapi-js:phase4> <urn:owlapi-js:phase4:v1>
  Import(<urn:owlapi-js:phase4:import>)
  Annotation(Annotation(rdfs:comment "nested"@en) rdfs:label "Phase 4"@en)

  Declaration(Annotation(rdfs:comment "declared class") Class(:A))
  Declaration(Datatype(:Code))
  Declaration(ObjectProperty(:p))
  Declaration(DataProperty(:d))
  Declaration(AnnotationProperty(:note))
  Declaration(NamedIndividual(:i))

  SubClassOf(Annotation(:note "annotated axiom") ObjectUnionOf(:A :B) ObjectIntersectionOf(:B ObjectSomeValuesFrom(ObjectInverseOf(:p) :C)))
  EquivalentClasses(:A ObjectUnionOf(:B ObjectComplementOf(:C)))
  DisjointClasses(:A :B :C)
  DisjointUnion(:A :B ObjectOneOf(:i _:anon))

  SubObjectPropertyOf(:p :q)
  SubObjectPropertyOf(ObjectPropertyChain(:p :q) :r)
  EquivalentObjectProperties(:p :q)
  DisjointObjectProperties(:p :q)
  InverseObjectProperties(:p :q)
  ObjectPropertyDomain(:p ObjectAllValuesFrom(:q :B))
  ObjectPropertyRange(:p ObjectHasValue(:q :i))
  FunctionalObjectProperty(:p)
  InverseFunctionalObjectProperty(:p)
  ReflexiveObjectProperty(:p)
  IrreflexiveObjectProperty(:q)
  SymmetricObjectProperty(:p)
  AsymmetricObjectProperty(:q)
  TransitiveObjectProperty(:r)

  SubDataPropertyOf(:d :e)
  EquivalentDataProperties(:d :e)
  DisjointDataProperties(:d :e)
  DataPropertyDomain(:d DataSomeValuesFrom(:e DataUnionOf(xsd:string xsd:integer)))
  DataPropertyRange(:d DatatypeRestriction(xsd:integer xsd:minInclusive "0"^^xsd:integer))
  FunctionalDataProperty(:d)
  DatatypeDefinition(:Code DataOneOf("alpha" "beta"@en))
  HasKey(:A (:p :q) (:d :e))

  SameIndividual(:i _:anon)
  DifferentIndividuals(:i :j)
  ClassAssertion(ObjectMinCardinality(1 :p :B) _:anon)
  ObjectPropertyAssertion(:p :i _:anon)
  NegativeObjectPropertyAssertion(:q _:anon :j)
  DataPropertyAssertion(:d :i "01"^^xsd:integer)
  NegativeDataPropertyAssertion(:e _:anon "plain")

  AnnotationAssertion(Annotation(:note "axiom metadata") :note _:anon <urn:owlapi-js:phase4:value>)
  SubAnnotationPropertyOf(:note rdfs:label)
  AnnotationPropertyDomain(:note <urn:owlapi-js:phase4:domain>)
  AnnotationPropertyRange(:note <urn:owlapi-js:phase4:range>)
)
