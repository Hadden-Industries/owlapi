# Repository-wide line ending enforcement (supersedes local core.autocrlf)
# - Auto-detect text vs binary files
# - Normalise text files to LF on commit and keep LF on checkout
* text=auto eol=lf

# Approved third-party source/notice assets retain their exact original bytes.
# The pinned catalogue provides per-file hashes and source/notice mappings.
util/owlapi-reference/publication-assets/** -text -diff -whitespace

# Retain upstream development scanner notice bytes exactly, including CRLF.
LICENSES/development/scancode-runtime/** -text -diff -whitespace
LICENSES/development/scancode-runtime/inventory.json text eol=lf diff

# Hash-bound upstream tool output retains its recorded whitespace.
docs/compatibility/profiles/java-owlapi-5.5.1/evidence/*.log -whitespace
docs/compatibility/profiles/java-owlapi-5.5.1/evidence/active-profiles.txt -whitespace

# Retain hash-bound native captures without Git newline conversion.
docs/compatibility/profiles/java-owlapi-5.5.1/evidence/import-lookup-precedence-java.txt -text !eol -whitespace
docs/provenance/history-reconstruction/control/signature-trust-source.txt -text !eol -whitespace
