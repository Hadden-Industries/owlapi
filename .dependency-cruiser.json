{
  "forbidden": [
    {
      "name": "no-unresolvable-runtime",
      "severity": "error",
      "from": {},
      "to": { "couldNotResolve": true }
    },
    {
      "name": "no-relative-runtime-escape",
      "severity": "error",
      "from": {},
      "to": { "path": "^\\.\\./" }
    },
    {
      "name": "circular-dependencies",
      "severity": "error",
      "from": {},
      "to": { "circular": true }
    },
    {
      "name": "structural-primitives-stay-independent",
      "severity": "error",
      "from": { "path": "^model/(?:kinds|structural)\\.js$" },
      "to": {
        "path": "^(?:internal/(?:parsing|loading|storage)/|model/owlOntologyManager\\.js$)",
        "reachable": true
      }
    },
    {
      "name": "loading-index-stays-independent",
      "severity": "error",
      "from": { "path": "^internal/loading/managedOntologyIndex\\.js$" },
      "to": {
        "path": "^(?:internal/(?:parsing|storage)/|model/owlOntologyManager\\.js$)",
        "reachable": true
      }
    }
  ],
  "options": {
    "moduleSystems": ["es6", "cjs"],
    "doNotFollow": { "path": "(^|/)node_modules/|^\\.\\./" }
  }
}
