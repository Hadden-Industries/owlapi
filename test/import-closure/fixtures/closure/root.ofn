Prefix(:=<urn:lifecycle:>)
Ontology(<urn:lifecycle:root> <urn:lifecycle:root:v1>
  Import(<urn:lifecycle:left>)
  Import(<urn:lifecycle:right>)
  Import(<urn:lifecycle:left>)
  Annotation(:note "root metadata")
  Declaration(Class(:Entity))
  Declaration(Class(:Root))
  Declaration(DataProperty(:origin))
  Declaration(DataProperty(:count))
  Declaration(DataProperty(:title))
  Declaration(ObjectProperty(:next))
  Declaration(AnnotationProperty(:note))
  SubClassOf(Annotation(:note "axiom note") :Root :Entity)
  DataPropertyAssertion(:origin _:shared "root")
  DataPropertyAssertion(:count _:shared "01"^^<http://www.w3.org/2001/XMLSchema#integer>)
  DataPropertyAssertion(:title _:shared "root value"@en)
  ObjectPropertyAssertion(:next _:shared _:shared)
  AnnotationAssertion(:note <urn:lifecycle:left> "axiom about imported ontology IRI")
)
