{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haddenindustries.com/schemas/owlapi/npm-package-evidence.v1.schema.json",
  "title": "owlapi authenticated npm package evidence corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "generatedBy",
    "package",
    "lockfile",
    "policy",
    "registryKeys",
    "occurrences",
    "artifacts",
    "blobs",
    "summary",
    "corpusRoot"
  ],
  "properties": {
    "$schema": { "const": "./npm-package-evidence.schema.json" },
    "schemaVersion": { "const": 1 },
    "generatedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version"],
      "properties": {
        "path": { "const": "util/acquire-npm-package-evidence.mjs" },
        "version": { "const": "1.0.0" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "lockfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "const": "package-lock.json" },
        "version": { "const": 3 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryOrigin", "provenance", "scanner"],
      "properties": {
        "registryOrigin": { "const": "https://registry.npmjs.org" },
        "provenance": { "const": "VERIFY_WHEN_PUBLISHED" },
        "scanner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "pythonVersion",
            "outputFormatVersion",
            "semanticOptions",
            "executionOptions"
          ],
          "properties": {
            "name": { "const": "scancode-toolkit" },
            "version": { "const": "32.5.0" },
            "pythonVersion": { "const": "3.14" },
            "outputFormatVersion": { "const": "4.1.0" },
            "semanticOptions": {
              "const": [
                "--copyright",
                "--generated",
                "--info",
                "--license",
                "--license-references",
                "--license-text",
                "--package",
                "--unknown-licenses"
              ]
            },
            "executionOptions": { "const": ["--processes", "1"] }
          }
        }
      }
    },
    "registryKeys": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/registryKey" }
    },
    "occurrences": {
      "type": "array",
      "items": { "$ref": "#/$defs/occurrence" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "blobs": {
      "type": "array",
      "items": { "$ref": "#/$defs/blobReference" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "corpusRoot": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sri": {
      "type": "string",
      "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
    },
    "selector": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "platformSelectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "os", "libc"],
      "properties": {
        "cpu": { "$ref": "#/$defs/selector" },
        "os": { "$ref": "#/$defs/selector" },
        "libc": { "$ref": "#/$defs/selector" }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencyPath",
        "dependencyName",
        "artifactId",
        "development",
        "optional",
        "platformSelectors"
      ],
      "properties": {
        "dependencyPath": { "type": "string", "pattern": "^node_modules/" },
        "dependencyName": { "type": "string", "minLength": 1 },
        "artifactId": { "$ref": "#/$defs/sha256" },
        "development": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "platformSelectors": { "$ref": "#/$defs/platformSelectors" }
      }
    },
    "blobReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "path", "kind"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "path": {
          "type": "string",
          "pattern": "^blobs/sha256/[0-9a-f]{2}/[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "ARCHIVE_INVENTORY",
            "NPM_PROVENANCE",
            "PACKAGE_EVIDENCE_FILE",
            "REGISTRY_SIGNATURE",
            "SCANCODE_FINDINGS"
          ]
        }
      }
    },
    "evidenceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": { "const": "VERIFIED" },
        "evidence": { "$ref": "#/$defs/blobReference" }
      }
    },
    "registrySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "publishedAt", "signatures", "evidence"],
      "properties": {
        "state": { "const": "VERIFIED" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/signature" }
        },
        "evidence": { "$ref": "#/$defs/blobReference" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": { "enum": ["VERIFIED", "NOT_PUBLISHED"] },
        "evidence": { "$ref": "#/$defs/blobReference" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "name",
        "version",
        "resolved",
        "integrity",
        "lockfileLicenses",
        "occurrencePaths",
        "tarball",
        "archive",
        "registrySignature",
        "provenance",
        "scan"
      ],
      "properties": {
        "artifactId": { "$ref": "#/$defs/sha256" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "resolved": {
          "type": "string",
          "pattern": "^https://registry\\.npmjs\\.org/.+\\.tgz$"
        },
        "integrity": { "$ref": "#/$defs/sri" },
        "lockfileLicenses": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "occurrencePaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^node_modules/" }
        },
        "tarball": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "bytes"],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "archive": { "$ref": "#/$defs/evidenceState" },
        "registrySignature": { "$ref": "#/$defs/registrySignature" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "scan": { "$ref": "#/$defs/evidenceState" }
      }
    },
    "keyid": {
      "type": "string",
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyid", "sig"],
      "properties": {
        "keyid": { "$ref": "#/$defs/keyid" },
        "sig": { "type": "string", "minLength": 1 }
      }
    },
    "registryKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyid", "keytype", "scheme", "key", "expires"],
      "properties": {
        "keyid": { "$ref": "#/$defs/keyid" },
        "keytype": { "const": "ecdsa-sha2-nistp256" },
        "scheme": { "const": "ecdsa-sha2-nistp256" },
        "key": { "type": "string", "minLength": 1 },
        "expires": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrenceCount",
        "artifactCount",
        "blobCount",
        "retainedBytes",
        "registrySignatureVerifiedCount",
        "provenanceVerifiedCount",
        "provenanceNotPublishedCount",
        "archiveVerifiedCount",
        "scanVerifiedCount"
      ],
      "properties": {
        "occurrenceCount": { "type": "integer", "minimum": 0 },
        "artifactCount": { "type": "integer", "minimum": 0 },
        "blobCount": { "type": "integer", "minimum": 0 },
        "retainedBytes": { "type": "integer", "minimum": 0 },
        "registrySignatureVerifiedCount": {
          "type": "integer",
          "minimum": 0
        },
        "provenanceVerifiedCount": { "type": "integer", "minimum": 0 },
        "provenanceNotPublishedCount": {
          "type": "integer",
          "minimum": 0
        },
        "archiveVerifiedCount": { "type": "integer", "minimum": 0 },
        "scanVerifiedCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
