        "test:cache-tests": "node test/cache-interceptor/cache-tests.mjs --ci",
        "test:cookies": "borp --timeout 180000 -p \"test/cookie/*.js\"",
        "test:eventsource": "npm run build:node && borp --timeout 180000 --expose-gc -p \"test/eventsource/*.js\"",
