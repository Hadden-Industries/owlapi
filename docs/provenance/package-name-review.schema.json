{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hadden-Industries/owlapi/blob/main/docs/provenance/package-name-review.schema.json",
  "title": "owlapi package-name and non-affiliation review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "review",
    "identity",
    "purpose",
    "compatibilityWording",
    "knownPriorUse",
    "evidence",
    "risks",
    "mitigations",
    "publicWording",
    "externalLegalAdviceObtained",
    "decision"
  ],
  "properties": {
    "$schema": { "const": "./package-name-review.schema.json" },
    "schemaVersion": { "const": 1 },
    "review": { "$ref": "#/$defs/review" },
    "identity": { "const": "owlapi" },
    "purpose": { "type": "string", "minLength": 1 },
    "compatibilityWording": { "type": "string", "minLength": 1 },
    "knownPriorUse": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "mitigations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "publicWording": { "type": "string", "minLength": 1 },
    "externalLegalAdviceObtained": { "type": "boolean" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "rationale", "conditions"],
      "properties": {
        "outcome": { "const": "APPROVED_WITH_MITIGATIONS" },
        "rationale": { "type": "string", "minLength": 1 },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedOn", "reviewer", "authority"],
      "properties": {
        "status": { "const": "REVIEWED" },
        "reviewedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewer": { "const": "Maksym Shostak" },
        "authority": { "type": "string", "minLength": 1 }
      }
    }
  }
}
