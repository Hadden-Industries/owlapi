{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hadden-Industries/owlapi/blob/main/docs/provenance/npm-package-identity-history.schema.json",
  "title": "npm package identity history evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "review",
    "registry",
    "packageName",
    "intendedCoordinate",
    "knownConsumedVersions",
    "observations",
    "conclusions"
  ],
  "properties": {
    "$schema": { "const": "./npm-package-identity-history.schema.json" },
    "schemaVersion": { "const": 1 },
    "review": { "$ref": "#/$defs/review" },
    "registry": { "const": "https://registry.npmjs.org/" },
    "packageName": { "const": "owlapi" },
    "intendedCoordinate": { "const": "owlapi@0.1.0-alpha.0" },
    "knownConsumedVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observedAt",
          "toolchain",
          "commandShape",
          "requestedSpecifiers",
          "resultCode",
          "summary",
          "interpretation"
        ],
        "properties": {
          "observedAt": { "type": "string", "minLength": 10 },
          "toolchain": { "type": "string", "minLength": 1 },
          "commandShape": { "type": "string", "minLength": 1 },
          "requestedSpecifiers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "resultCode": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "interpretation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conclusions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedOn", "reviewer", "capacity"],
      "properties": {
        "status": { "const": "REVIEWED" },
        "reviewedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewer": { "const": "Maksym Shostak" },
        "capacity": { "type": "string", "minLength": 1 }
      }
    }
  }
}
