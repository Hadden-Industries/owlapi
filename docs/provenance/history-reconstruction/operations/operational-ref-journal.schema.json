{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haddenindustries.com/schemas/owlapi/phase19/operational-ref-journal-record.v1.schema.json",
  "title": "Phase 19 append-only operational ref journal record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sequence", "previousRecordSha256", "event", "recordSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "previousRecordSha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
    },
    "event": {
      "oneOf": [
        { "$ref": "#/$defs/initialEvent" },
        { "$ref": "#/$defs/plannedEvent" },
        { "$ref": "#/$defs/authorizedEvent" },
        { "$ref": "#/$defs/resultEvent" },
        { "$ref": "#/$defs/deferredEvent" }
      ]
    },
    "recordSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "objectOid", "commitOid", "objectType", "observation"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "objectOid": { "$ref": "#/$defs/oid" },
        "commitOid": { "$ref": "#/$defs/oid" },
        "objectType": { "enum": ["commit", "tag"] },
        "observation": { "enum": ["EXPLICIT", "LOCAL_GIT"] }
      }
    },
    "initialEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "observedAt",
        "authorizationState",
        "baseOid",
        "tipOid",
        "refs",
        "commitInventorySha256",
        "partitionDecisionsSha256",
        "referenceCandidatesSha256"
      ],
      "properties": {
        "type": { "const": "INITIAL_STATE" },
        "observedAt": { "type": "string", "format": "date-time" },
        "authorizationState": { "const": "NOT_AUTHORIZED" },
        "baseOid": { "$ref": "#/$defs/oid" },
        "tipOid": { "$ref": "#/$defs/oid" },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "commitInventorySha256": { "$ref": "#/$defs/sha256" },
        "partitionDecisionsSha256": { "$ref": "#/$defs/sha256" },
        "referenceCandidatesSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "plannedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "observedAt", "scope", "ref", "expectedOldOid", "intendedNewOid", "operation"],
      "properties": {
        "type": { "const": "REF_UPDATE_PLANNED" },
        "observedAt": { "type": "string", "format": "date-time" },
        "scope": { "enum": ["LOCAL", "REMOTE"] },
        "ref": { "type": "string", "minLength": 1 },
        "destinationRef": { "type": "string", "minLength": 1 },
        "expectedOldOid": { "$ref": "#/$defs/oid" },
        "intendedNewOid": { "$ref": "#/$defs/oid" },
        "operation": {
          "enum": [
            "COMPARE_AND_SWAP_FAST_FORWARD",
            "COMPARE_AND_SWAP_REPOINT",
            "COMPARE_AND_SWAP_RENAME"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "const": "COMPARE_AND_SWAP_RENAME" } },
            "required": ["operation"]
          },
          "then": {
            "required": ["destinationRef"],
            "properties": {
              "destinationRef": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "authorizedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "authorizedAt",
        "authorizedBy",
        "authorizationBasis",
        "scope",
        "ref",
        "expectedOldOid",
        "intendedNewOid"
      ],
      "properties": {
        "type": { "const": "REF_UPDATE_AUTHORIZED" },
        "authorizedAt": { "type": "string", "format": "date-time" },
        "authorizedBy": { "type": "string", "minLength": 1 },
        "authorizationBasis": { "type": "string", "minLength": 1 },
        "scope": { "const": "LOCAL" },
        "ref": { "type": "string", "minLength": 1 },
        "destinationRef": { "type": "string", "minLength": 1 },
        "expectedOldOid": { "$ref": "#/$defs/oid" },
        "intendedNewOid": { "$ref": "#/$defs/oid" }
      }
    },
    "resultEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "observedAt",
        "scope",
        "ref",
        "expectedOldOid",
        "intendedNewOid",
        "observedBeforeOid",
        "observedAfterOid",
        "operation",
        "result"
      ],
      "properties": {
        "type": { "const": "REF_UPDATE_RESULT" },
        "observedAt": { "type": "string", "format": "date-time" },
        "scope": { "enum": ["LOCAL", "REMOTE"] },
        "ref": { "type": "string", "minLength": 1 },
        "destinationRef": { "type": "string", "minLength": 1 },
        "expectedOldOid": { "$ref": "#/$defs/oid" },
        "intendedNewOid": { "$ref": "#/$defs/oid" },
        "observedBeforeOid": { "$ref": "#/$defs/oid" },
        "observedAfterOid": { "$ref": "#/$defs/oid" },
        "observedSourceAfterOid": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/oid" }]
        },
        "observedDestinationBeforeOid": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/oid" }]
        },
        "operation": {
          "enum": [
            "COMPARE_AND_SWAP_FAST_FORWARD",
            "COMPARE_AND_SWAP_REPOINT",
            "COMPARE_AND_SWAP_RENAME"
          ]
        },
        "result": { "enum": ["PASS", "FAIL"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "operation": { "const": "COMPARE_AND_SWAP_RENAME" } },
            "required": ["operation"]
          },
          "then": {
            "required": [
              "destinationRef",
              "observedSourceAfterOid",
              "observedDestinationBeforeOid"
            ],
            "properties": {
              "destinationRef": { "type": "string", "minLength": 1 },
              "observedSourceAfterOid": {
                "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/oid" }]
              },
              "observedDestinationBeforeOid": {
                "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/oid" }]
              }
            }
          }
        }
      ]
    },
    "deferredEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "observedAt", "scope", "ref", "expectedOldOid", "intendedNewOid", "reason"],
      "properties": {
        "type": { "const": "REF_UPDATE_DEFERRED" },
        "observedAt": { "type": "string", "format": "date-time" },
        "scope": { "const": "REMOTE" },
        "ref": { "type": "string", "minLength": 1 },
        "expectedOldOid": { "$ref": "#/$defs/oid" },
        "intendedNewOid": { "$ref": "#/$defs/oid" },
        "reason": { "const": "SEPARATE_PUSH_AUTHORIZATION_REQUIRED" }
      }
    }
  }
}
