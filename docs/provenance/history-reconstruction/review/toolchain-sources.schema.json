{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haddenindustries.com/schemas/owlapi/phase19/toolchain-sources.v1.schema.json",
  "title": "Phase 19 external toolchain source evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observedAt", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "releaseUrl",
        "tag",
        "sourceCommitOid",
        "tagVerification",
        "archive",
        "executable"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "releaseUrl": { "type": "string", "format": "uri" },
        "tag": { "type": "string", "minLength": 1 },
        "tagObjectOid": { "oneOf": [{ "$ref": "#/$defs/sha1" }, { "type": "null" }] },
        "sourceCommitOid": { "$ref": "#/$defs/sha1" },
        "tagVerification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "enum": ["VERIFIED", "UNSIGNED"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "size", "sha256", "digestAuthority"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "size": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "digestAuthority": { "type": "string", "minLength": 1 }
          }
        },
        "executable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256", "identity", "verification"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "identity": { "type": "string", "minLength": 1 },
            "gitBlobOid": { "$ref": "#/$defs/sha1" },
            "verification": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
