{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:owlapi:java-release-provenance:1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "qualification": {
            "type": "object",
            "properties": { "status": { "const": "qualified" } }
          }
        }
      },
      "then": {
        "properties": {
          "qualification": {
            "type": "object",
            "properties": {
              "completedAt": { "type": "string", "format": "date-time" }
            }
          },
          "oracle": {
            "type": "object",
            "properties": {
              "harnessSourceCommitObjectId": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "behaviorProfileId",
    "qualification",
    "upstream",
    "mavenCentral",
    "toolchain",
    "sourceBuild",
    "oracle"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "behaviorProfileId": {
      "const": "java-owlapi-5.5.1"
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completedAt", "evidenceManifestPath"],
      "properties": {
        "status": {
          "enum": ["unqualified", "qualified"]
        },
        "completedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceManifestPath": {
          "type": "string",
          "pattern": "^(?:\\.\\./)*[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryUrl",
        "releaseVersion",
        "gitObjectFormat",
        "tag",
        "commit"
      ],
      "properties": {
        "repositoryUrl": {
          "const": "https://github.com/owlcs/owlapi"
        },
        "releaseVersion": {
          "const": "5.5.1"
        },
        "gitObjectFormat": {
          "const": "sha1"
        },
        "tag": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "objectType",
            "tagObjectId",
            "peeledCommitObjectId",
            "taggedAt",
            "signature"
          ],
          "properties": {
            "name": {
              "const": "owlapi-parent-5.5.1"
            },
            "objectType": {
              "const": "tag"
            },
            "tagObjectId": {
              "const": "8003508e8c185579898ca4eda1245f808461d06a"
            },
            "peeledCommitObjectId": {
              "const": "f760b3a4c107c6d5f90f856e5680c39b18af646f"
            },
            "taggedAt": {
              "type": "string",
              "format": "date-time"
            },
            "signature": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verificationStatus",
                "signerFingerprint",
                "verificationEvidencePath"
              ],
              "properties": {
                "verificationStatus": {
                  "enum": [
                    "not-checked",
                    "unsigned",
                    "verified",
                    "invalid",
                    "unverifiable"
                  ]
                },
                "signerFingerprint": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-F0-9]{40,64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verificationEvidencePath": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:\\.\\./)*[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commitObjectId",
            "treeObjectId",
            "subject",
            "committedAt",
            "signature"
          ],
          "properties": {
            "commitObjectId": {
              "const": "f760b3a4c107c6d5f90f856e5680c39b18af646f"
            },
            "treeObjectId": {
              "const": "6b87391a36b7341f7253f57046b5b8621d3d0ac8"
            },
            "subject": {
              "const": "OWLAPI version 5.5.1"
            },
            "committedAt": {
              "type": "string",
              "format": "date-time"
            },
            "signature": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "verificationStatus",
                "signerFingerprint",
                "verificationEvidencePath"
              ],
              "properties": {
                "verificationStatus": {
                  "enum": [
                    "not-checked",
                    "unsigned",
                    "verified",
                    "invalid",
                    "unverifiable"
                  ]
                },
                "signerFingerprint": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-F0-9]{40,64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verificationEvidencePath": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(?:\\.\\./)*[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "mavenCentral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryUrl",
        "primaryCoordinate",
        "artifacts",
        "dependencyLock"
      ],
      "properties": {
        "repositoryUrl": {
          "const": "https://repo.maven.apache.org/maven2"
        },
        "primaryCoordinate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["groupId", "artifactId", "version"],
          "properties": {
            "groupId": {
              "const": "net.sourceforge.owlapi"
            },
            "artifactId": {
              "const": "owlapi-distribution"
            },
            "version": {
              "const": "5.5.1"
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "groupId",
              "artifactId",
              "version",
              "artifactType",
              "classifier",
              "byteLength",
              "sha256",
              "signature"
            ],
            "properties": {
              "groupId": {
                "const": "net.sourceforge.owlapi"
              },
              "artifactId": {
                "const": "owlapi-distribution"
              },
              "version": {
                "const": "5.5.1"
              },
              "artifactType": {
                "enum": ["pom", "jar"]
              },
              "classifier": {
                "type": "null"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "signature": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "verificationStatus",
                  "signerFingerprint",
                  "verificationEvidencePath",
                  "signerTrustDecisionReference"
                ],
                "properties": {
                  "verificationStatus": {
                    "enum": [
                      "not-checked",
                      "unsigned",
                      "verified",
                      "invalid",
                      "unverifiable"
                    ]
                  },
                  "signerFingerprint": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[A-F0-9]{40,64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "verificationEvidencePath": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:\\.\\./)*[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "signerTrustDecisionReference": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "dependencyLock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "repositoryUrl",
            "oracleExecutionClosureStatus",
            "sourceBuildClosureStatus"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?:\\.\\./)*[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "repositoryUrl": {
              "const": "https://repo.maven.apache.org/maven2"
            },
            "oracleExecutionClosureStatus": {
              "enum": ["not-checked", "complete", "incomplete"]
            },
            "sourceBuildClosureStatus": {
              "enum": ["not-checked", "complete", "incomplete"]
            }
          }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jdk", "maven", "operatingSystem"],
      "properties": {
        "jdk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "distributionName",
            "version",
            "distributionArchiveSha256",
            "installationIdentityEvidencePath"
          ],
          "properties": {
            "distributionName": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "distributionArchiveSha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "installationIdentityEvidencePath": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?:\\.\\./)*[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "maven": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "distributionArchiveSha256"],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "distributionArchiveSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "operatingSystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "architecture"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "architecture": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sourceBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommitObjectId",
        "requiresCleanCheckout",
        "checkoutVerificationStatus",
        "invocation",
        "dependencyResolutionMode",
        "artifactComparison"
      ],
      "properties": {
        "sourceCommitObjectId": {
          "const": "f760b3a4c107c6d5f90f856e5680c39b18af646f"
        },
        "requiresCleanCheckout": {
          "const": true
        },
        "checkoutVerificationStatus": {
          "enum": ["not-checked", "clean", "dirty"]
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "arguments",
            "workingDirectory",
            "environment"
          ],
          "properties": {
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "workingDirectory": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "dependencyResolutionMode": {
          "enum": ["offline-after-seeding", "online-with-offline-replay"]
        },
        "artifactComparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "centralJarSha256",
            "rebuiltJarSha256",
            "areJarsByteIdentical",
            "byteDifferenceExplanation",
            "behavioralComparisonEvidencePath"
          ],
          "properties": {
            "centralJarSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rebuiltJarSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "areJarsByteIdentical": {
              "type": "boolean"
            },
            "byteDifferenceExplanation": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "behavioralComparisonEvidencePath": {
              "type": "string",
              "pattern": "^(?:\\.\\./)*[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
            }
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harnessSourceCommitObjectId",
        "fixtureManifestSha256",
        "observationManifestSha256",
        "invocation",
        "classpathLockSha256"
      ],
      "properties": {
        "harnessSourceCommitObjectId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixtureManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observationManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "invocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable",
            "arguments",
            "workingDirectory",
            "environment"
          ],
          "properties": {
            "executable": {
              "type": "string",
              "minLength": 1
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "workingDirectory": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "classpathLockSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
