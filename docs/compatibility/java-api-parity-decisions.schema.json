    "storageReasonDecisionContract": {
      "type": "object",
      "properties": {
        "javaAuthorities": {
          "const": [
            {
              "type": "org.semanticweb.owlapi.model.OWLOntologyStorageException",
              "sourcePath": "api/src/main/java/org/semanticweb/owlapi/model/OWLOntologyStorageException.java",
              "members": [
