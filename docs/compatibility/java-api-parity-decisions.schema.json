    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phase",
        "javaAuthorities",
        "jsBindings",
        "category",
        "rationale",
        "rule",
        "approvalSource",
        "verificationPaths"
      ],
      "properties": {
        "id": {
          "enum": [
            "PARITY-TARGET-WRITER-OMISSION",
            "PARITY-TARGET-ATOMIC-COMMIT",
            "PARITY-ERROR-SUFFIX",
            "PARITY-ERROR-HIERARCHY",
            "PARITY-ERROR-NAMESPACE",
            "PARITY-STORAGE-REASON"
          ]
        },
        "phase": {
          "const": 21
        },
        "javaAuthorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "sourcePath",
              "members"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^org\\.semanticweb\\.owlapi\\.(io|model)\\.[A-Za-z]+$"
              },
              "sourcePath": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
