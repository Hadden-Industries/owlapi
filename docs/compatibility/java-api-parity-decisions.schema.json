            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "sourceReaderAllowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line",
              "expression",
              "receiverType",
              "evidence"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "expression": {
                "type": "string",
                "minLength": 1
              },
              "receiverType": {
                "const": "StringDocumentSource"
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "obsoleteUseCount": {
          "const": 0
        },
        "scanSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "disposition": {
          "enum": ["NO_OBSOLETE_USAGE", "MIGRATED"]
        },
        "changedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
          }
        },
        "migrationCommit": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          ]
        },
        "reviewedPatchSha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "installedCandidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "evidenceSha256", "result"],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evidenceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "result": {
              "const": "PASS"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "NO_OBSOLETE_USAGE"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "changedPaths": {
                "maxItems": 0,
                "type": "array"
              },
              "migrationCommit": {
                "type": "null"
              },
              "reviewedPatchSha256": {
                "type": "null"
              }
            },
            "type": "object"
          },
          "else": {
            "properties": {
              "changedPaths": {
                "minItems": 1,
                "type": "array"
              },
              "reviewedPatchSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "type": "object"
          }
        }
      ]
    },
