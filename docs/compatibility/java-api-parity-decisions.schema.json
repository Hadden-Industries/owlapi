      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "baselineCommit",
        "auditedPathClasses",
        "excludedPathClasses",
        "sourceReaderAllowlist",
        "obsoleteUseCount",
        "scanSha256",
        "disposition",
        "changedPaths",
        "migrationCommit",
        "reviewedPatchSha256",
