{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hadden-industries.github.io/owlapi/java-api-parity-decisions.schema.json",
  "title": "Java API parity decisions and qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "qualification",
    "developmentBaseline",
    "acceptedReleaseBaseline",
    "javaAuthority",
    "decisions",
    "forbiddenMembers",
    "forbiddenBindings",
    "consumerMigrations",
    "phase21",
    "phase22"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "qualification": {
      "enum": ["PRE_INTEGRATION", "RECONCILED"]
    },
    "developmentBaseline": {
      "$ref": "#/$defs/baseline"
    },
    "acceptedReleaseBaseline": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/releaseBaseline"
        }
      ]
    },
    "javaAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision"],
      "properties": {
        "version": {
          "const": "5.5.1"
        },
        "revision": {
          "const": "d7e997a53b470e32700de89cc610d9daf01ea769"
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/decision"
      },
      "allOf": [
        {
          "contains": {
            "$ref": "#/$defs/targetDecisionContract",
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "PARITY-TARGET-WRITER-OMISSION"
              },
              "category": {
                "const": "OMISSION"
              }
            }
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/targetDecisionContract",
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "PARITY-TARGET-ATOMIC-COMMIT"
              },
              "category": {
                "const": "BEHAVIOR_ADAPTATION"
              }
            }
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/storageErrorDecisionContract",
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "PARITY-ERROR-SUFFIX"
              },
              "category": {
                "const": "NAME_ADAPTATION"
              }
            }
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/storageErrorDecisionContract",
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "PARITY-ERROR-HIERARCHY"
              },
              "category": {
                "const": "HIERARCHY_ADAPTATION"
              }
            }
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/storageErrorDecisionContract",
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "PARITY-ERROR-NAMESPACE"
              },
              "category": {
                "const": "NAMESPACE_ADAPTATION"
              }
            }
          }
        },
        {
          "contains": {
            "$ref": "#/$defs/storageReasonDecisionContract",
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "const": "PARITY-STORAGE-REASON"
              },
              "category": {
                "const": "DIAGNOSTIC_ADAPTATION"
              }
            }
          }
        }
      ]
    },
    "forbiddenMembers": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "io.StringDocumentTarget.prototype.getText",
          "io.StringDocumentTarget.prototype.getWriter",
          "io.StringDocumentTarget.prototype.write",
          "io.StringDocumentTarget.prototype.append"
        ]
      }
    },
    "forbiddenBindings": {
      "const": [
        "io.UnrepresentableOntologyError",
        "model.OWLOntologyStorageError",
        "model.OWLStorerNotFoundError"
      ]
    },
    "consumerMigrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webvowl"],
      "properties": {
        "webvowl": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/webvowl"
            }
          ]
        }
      }
    },
    "phase21": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "registrySha256",
        "publicBindings",
        "newNamespaces"
      ],
      "properties": {
        "status": {
          "enum": ["IN_PROGRESS", "COMPLETE"]
        },
        "registrySha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "publicBindings": {
          "const": [
            "io.StringDocumentTarget",
            "io.OWLOntologyStorageError",
            "io.OWLStorerNotFoundError"
          ]
        },
        "newNamespaces": {
          "const": []
        }
      }
    },
    "phase22": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decisions"],
      "properties": {
        "status": {
          "const": "IN_PROGRESS"
        },
        "decisions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lifecycleDecision"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "const": "LIFECYCLE-CLOSURE-COLLECTION-MAPPING"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "const": "LIFECYCLE-FOREIGN-ONTOLOGY-STATE"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "const": "LIFECYCLE-MUTATION-RESULT-ATOMICITY"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "const": "LIFECYCLE-CHANGE-OVERLOAD-SUBSET"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "const": "LIFECYCLE-PROVIDER-SNAPSHOT"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "const": "LIFECYCLE-MERGER-OPTIONAL-FILTER"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "const": "LIFECYCLE-ASYNC-SAVE-OVERLOAD"
                  }
                }
              }
            },
            {
              "contains": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "const": "LIFECYCLE-LOSSLESS-STORAGE"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qualification": {
            "const": "PRE_INTEGRATION"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "acceptedReleaseBaseline": {
            "type": "null"
          },
          "consumerMigrations": {
            "properties": {
              "webvowl": {
                "type": "null"
              }
            },
            "type": "object"
          },
          "phase21": {
            "properties": {
              "status": {
                "const": "IN_PROGRESS"
              },
              "registrySha256": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "acceptedReleaseBaseline": {
            "$ref": "#/$defs/releaseBaseline"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "phase21": {
            "properties": {
              "status": {
                "const": "COMPLETE"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "qualification": {
            "const": "RECONCILED"
          },
          "phase21": {
            "properties": {
              "registrySha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "type": "object"
          },
          "consumerMigrations": {
            "properties": {
              "webvowl": {
                "$ref": "#/$defs/webvowl"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ],
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "registrySha256"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "registrySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "releaseBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "packageIntegrity", "registrySha256"],
      "properties": {
        "tag": {
          "const": "v0.1.0"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "packageIntegrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
        },
        "registrySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "targetDecisionContract": {
      "type": "object",
      "properties": {
        "javaAuthorities": {
          "const": [
            {
              "type": "org.semanticweb.owlapi.io.StringDocumentTarget",
              "sourcePath": "api/src/main/java/org/semanticweb/owlapi/io/StringDocumentTarget.java",
              "members": [
                "StringDocumentTarget()",
                "String toString()",
                "Optional<Writer> getWriter()"
              ]
            }
          ]
        },
        "jsBindings": {
          "const": ["io.StringDocumentTarget"]
        }
      }
    },
    "storageErrorDecisionContract": {
      "type": "object",
      "properties": {
        "javaAuthorities": {
