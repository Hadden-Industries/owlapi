  "decisions": [
    {
      "id": "PARITY-TARGET-WRITER-OMISSION",
      "phase": 21,
      "javaAuthorities": [
        {
          "type": "org.semanticweb.owlapi.io.StringDocumentTarget",
          "sourcePath": "api/src/main/java/org/semanticweb/owlapi/io/StringDocumentTarget.java",
          "members": [
            "StringDocumentTarget()",
            "String toString()",
            "Optional<Writer> getWriter()"
          ]
        }
      ],
      "jsBindings": ["io.StringDocumentTarget"],
      "category": "OMISSION",
      "rationale": "JavaScript has no java.io.Writer protocol; an exposed writer would defeat complete-text atomicity.",
      "rule": "Expose only constructor and toString; omit getWriter, getText, write, append, and constructor text.",
      "approvalSource": "docs/plans/java-api-parity-precondition.md",
      "verificationPaths": [
        "governance.test.js",
        "io/io.test.js",
        "test/package-boundary.test.mjs"
      ]
    },
    {
      "id": "PARITY-TARGET-ATOMIC-COMMIT",
      "phase": 21,
      "javaAuthorities": [
        {
          "type": "org.semanticweb.owlapi.io.StringDocumentTarget",
          "sourcePath": "api/src/main/java/org/semanticweb/owlapi/io/StringDocumentTarget.java",
          "members": [
            "StringDocumentTarget()",
            "String toString()",
            "Optional<Writer> getWriter()"
          ]
        }
      ],
      "jsBindings": ["io.StringDocumentTarget"],
      "category": "BEHAVIOR_ADAPTATION",
      "rationale": "The consumer requires failed saves to preserve prior text, unlike incremental Java writer mutation.",
      "rule": "Replace complete text through one package-private helper only after target identity and string validation; expose no mutator.",
      "approvalSource": "docs/plans/java-api-parity-precondition.md",
      "verificationPaths": [
        "governance.test.js",
        "io/io.test.js",
        "test/package-boundary.test.mjs"
      ]
    },
    {
