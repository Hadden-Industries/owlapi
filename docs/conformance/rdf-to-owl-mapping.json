  "extensionsAndPolicies": [
    {
      "id": "OWLAPI-ANONYMOUS-WITHOUT-HEADER",
      "policy": "A dataset with no owl:Ontology type reconstructs an anonymous ontology, matching the public OWLAPI loading model for headerless RDF documents."
    },
    {
      "id": "OWL-SIGNIFICANT-UNCONSUMED",
      "policy": "Strict mode rejects unconsumed OWL-significant triples; compatible mode emits a structured warning rather than silently discarding them."
    },
    {
      "id": "RDF-1.2-TRIPLE-TERMS",
      "policy": "RDF 1.2 triple terms are rejected because OWL 2 assigns them no structural mapping."
    }
  ]
